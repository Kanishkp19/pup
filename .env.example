# PUPPY Environment Variables
# Copy this file to .env and fill in values

# Google Gemini API key for tools/nb_generate.py (optional if using built-in agent image tools)
GEMINI_API_KEY=AIzaSy...

# Nano Banana Model ID (gemini-3-pro-image-preview or gemini-2.5-flash-image)
NANO_BANANA_MODEL=gemini-2.5-flash-image

# Image generation size (1K or 2K)
NB_IMAGE_SIZE=1K

# Maximum retries per frame if QA validation fails
NB_MAX_RETRIES=3

# Concurrency for asset generation (keep <= 2 to avoid rate limits and drift)
NB_CONCURRENCY=2

# Rust log level (e.g., puppy=info, debug, trace)
RUST_LOG=puppy=info

# Optional macOS code signing and notarization credentials
# APPLE_CERTIFICATE=
# APPLE_CERTIFICATE_PASSWORD=
# APPLE_ID=
# APPLE_ID_PASSWORD=
# APPLE_TEAM_ID=
